# Local development only. These values are example credentials, not production secrets.
# Copy this file to .env in the repository root before starting Docker or the API.
# Docker Compose reads .env automatically for ${VAR} substitution.
# The API and the test runner do not. Their npm scripts load this file with
# Node's --env-file=../.env flag.

POSTGRES_USER=tasks
POSTGRES_PASSWORD=tasks
POSTGRES_DB=tasks
# Host port. 5432 is left for a Postgres already installed on the machine.
# 5433 is also avoided because other local Docker projects often publish it.
POSTGRES_PORT=5434

DATABASE_URL=postgres://tasks:tasks@localhost:5434/tasks
TEST_DATABASE_URL=postgres://tasks:tasks@localhost:5434/tasks_test

API_PORT=3001
